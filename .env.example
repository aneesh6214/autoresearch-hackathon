# Copy this file to .env and fill in real values.

OPENAI_API_KEY=

# Strong frontier defaults for the hackathon loop.
OPENAI_TUTOR_MODEL=gpt-5.5
OPENAI_RESEARCH_MODEL=gpt-5.5
OPENAI_JUDGE_MODEL=gpt-5.5

# There is no separate API "fast mode" toggle.
# Medium reasoning is the balanced starting point for quality and runtime.
# Raise specific phases to high/xhigh only after measuring candidate runtime.
OPENAI_TUTOR_REASONING_EFFORT=medium
OPENAI_RESEARCH_REASONING_EFFORT=medium
OPENAI_JUDGE_REASONING_EFFORT=medium
OPENAI_TEXT_VERBOSITY=medium
OPENAI_MAX_OUTPUT_TOKENS=8192
OPENAI_INPUT_USD_PER_1M_TOKENS=15.0
OPENAI_OUTPUT_USD_PER_1M_TOKENS=60.0
OPENAI_TOTAL_USD_PER_1M_TOKENS=30.0

MODAL_OPENAI_SECRET_NAME=openai-api-key
MODAL_ESTIMATED_USD_PER_WORKER_HOUR=0.25
